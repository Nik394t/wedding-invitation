  "narrative": {
    "northStar": "Тиснёный конверт из семейной шкатулки",
    "overview": "Приглашение — письмо, которое вскрывают по сургучной печати: пудровый конверт со слепым тиснением роз, внутри арочные бумажные окна с фотографиями, серебряные медальоны со стираемым слоем и нить, связывающая два дня.",
    "keyCharacteristics": [
      "Физические предметы вместо UI-блоков: конверт, сургуч, паспарту, отрывной календарь, открытка, веер тканей.",
      "Одна рамка на всю страницу — килевидная арка.",
      "Один авторский рисунок флористики в двух материалах: слепое тиснение и бумажные розы.",
      "Каллиграфия для чувства, антиква русской печати для фактов.",
      "Утро на кремовой бумаге, вечер на бордовом поле с закатным свечением.",
      "Звук — часть предметного мира: сургуч, бумага, серебро и тихая мелодия, только после нажатия гостя."
    ],
    "rules": [
      {
        "name": "The Paper Light Rule",
        "body": "Тон поверхности меняется, только когда меняется свет или материал; декоративных цветных плашек нет.",
        "section": "colors"
      },
      {
        "name": "The Silver Is Foil Rule",
        "body": "Серебро всегда градиент-фольга и всегда тонкое: линия, ободок, нить, заклёпка.",
        "section": "colors"
      },
      {
        "name": "The Evening Rule",
        "body": "Бордовое поле принадлежит только главе 24 октября; розовое свечение за аркой подхватывает стену на портрете пары.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Каллиграфия никогда не несёт факт, по которому гость будет действовать; время, адрес и день недели набраны антиквой.",
        "section": "typography"
      },
      {
        "name": "The No Script Abbreviations Rule",
        "body": "Аббревиатуры каллиграфией не набираются: «Роспись» — каллиграфия, «в ЗАГСе» — курсив антиквы.",
        "section": "typography"
      },
      {
        "name": "The Object Shape Rule",
        "body": "Форма берётся у предмета: письмо, отпечаток, медальон, лист календаря, лоскут ткани.",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do оставлять фотографии главными: детское фото и портрет пары — самые крупные элементы своих сцен.",
      "Do править все фразы в src/content/invitation.ts.",
      "Do проверять новые размеры от 320px; адреса и дни недели не мельче 15px.",
      "Do давать каждому движению физический смысл из грамматики: бумага, фото, каллиграфия, чернила."
    ],
    "donts": [
      "Don't возвращать прямоугольные карточки, скруглённые панели, стекло, неон и технологичные градиенты.",
      "Don't писать, что пара знакома с детства: совместный детский снимок собран из двух отдельных фотографий.",
      "Don't набирать каллиграфией время, адреса и аббревиатуры.",
      "Don't использовать золото, чистый белый и стоковые цветы.",
      "Don't добавлять имена, RSVP, таймер, подарки и неподтверждённые факты; «Тили-тили тесто» запрещено.",
      "Don't включать звук без действия гостя и добавлять звуки элементам без физического прообраза."
